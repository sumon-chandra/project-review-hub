{
	"name": "express",
	"type": "module",
	"scripts": {
		"dev": "tsx watch ./src/server.ts",
		"build": "bunx tsc --noEmit",
		"db:migrate": "bunx prisma migrate dev --name",
		"db:push": "bunx prisma db push",
		"db:generate": "bunx prisma generate",
		"db:seed": "bun run ./prisma/seed.ts",
		"postinstall": "prisma generate"
	},
	"prisma": {
		"seed": "bun run ./prisma/seed.ts"
	},
	"dependencies": {
		"@prisma/adapter-pg": "^7.10.1",
		"@prisma/client": "^7.10.1",
		"bcryptjs": "^3.0.3",
		"cors": "^2.8.6",
		"dotenv": "^17.4.2",
		"express": "5.1.0",
		"express-rate-limit": "^8.7.1",
		"http-status": "^2.1.0",
		"jsonwebtoken": "^9.0.3",
		"pg": "^8.23.1",
		"tsx": "^4.22.3",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@types/bcryptjs": "^3.0.0",
		"@types/bun": "1.3.1",
		"@types/cors": "^2.8.19",
		"@types/dotenv": "^8.2.3",
		"@types/express": "5.0.0",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/pg": "^8.23.1",
		"prisma": "^7.10.1",
		"typescript": "5.8.3"
	}
}
