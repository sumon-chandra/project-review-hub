								"value": "Bearer {{studentToken}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"projectName\": \"Modern E-Commerce Platform\",\n  \"repositoryUrl\": \"https://github.com/alice/ecommerce-store\",\n  \"liveUrl\": \"https://alice-ecommerce-store.vercel.app\",\n  \"description\": \"Initial submission attempt #1: Next.js frontend with Express backend and Prisma PostgreSQL database. Includes authentication, product catalog, and cart.\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/submissions",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "submissions"]
						},
						"description": "Submit initial project. Creates Project and ProjectSubmission (Attempt #1, status PENDING)."
					},
					"response": []
				},
