									"const response = pm.response.json();",
									"if (response.data && response.data.submission) {",
									"    pm.collectionVariables.set('submissionId', response.data.submission.id);",
									"    console.log('Saved submissionId:', response.data.submission.id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
